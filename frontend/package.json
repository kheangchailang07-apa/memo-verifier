{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev1": "vite --mode apa1",
    "dev2": "vite --mode apa2",
    "build": "vite build",
    "build1": "vite build --mode apa1 --outDir dist1",
    "build2": "vite build --mode apa2 --outDir dist2",
    "preview": "vite preview",
    "serve1": "pm2 start ecosystem.config.cjs --only memo-frontend1",
    "serve2": "pm2 start ecosystem.config.cjs --only memo-frontend2",
    "preview:stop": "pm2 delete memo-frontend1 memo-frontend2",
    "clean": "rm -rf dist dist1 dist2 server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
